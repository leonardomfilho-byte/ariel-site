# Configuração da integração com a API da SEFA-PA (DEC).
# Copie para .env e preencha. O .env NÃO vai para o git.
#
# Os endereços abaixo foram confirmados em 20/08/2026 na página
# "Como começar" do portal de integrações da SEFA (apis.sefa.pa.gov.br),
# passo 4. Não são suposição: é o exemplo que eles mesmos publicam.

# Onde se pega o token. ATENÇÃO: este host é diferente do portal do
# contribuinte. Note também que o caminho NÃO tem /realms/... no meio —
# é /protocol/openid-connect/token direto.
SEFA_TOKEN_URL=https://apis-auth.sefa.pa.gov.br/protocol/openid-connect/token

# Deduzido do token URL quando vazio. Deixe assim.
SEFA_ISSUER_URL=

# Credenciais da aplicação, em "Minhas aplicações" no portal.
# Em 20/08 havia TRÊS aplicações ativas para o DEC — confira que o
# client_id e o client_secret são do MESMO cadastro.
SEFA_CLIENT_ID=
SEFA_CLIENT_SECRET=

# O exemplo oficial não manda escopo. Deixe vazio.
SEFA_SCOPE=

# CNPJ da empresa, só dígitos.
SEFA_CNPJ=30889880000160

# CERTIFICADO: o fluxo documentado pela SEFA é client_credentials puro,
# SEM certificado de cliente. Deixe estes campos vazios — o diagnóstico
# roda a comparação com e sem certificado de qualquer forma, e é
# justamente essa comparação que mostra se ele faz alguma diferença.
SEFA_CERT_PFX=
SEFA_CERT_SENHA=

# Primeiro serviço da API. Segundo a documentação, devolve os vínculos
# ligados ao CPF/CNPJ que estiver dentro do token — é o teste mais barato
# de "o token vale para o DEC?".
SEFA_API_URL=https://apis-publicas-gw.sefa.pa.gov.br/dec/vinculos

# Não usar. O fluxo da SEFA é client_credentials.
SEFA_USUARIO_SENHA=
