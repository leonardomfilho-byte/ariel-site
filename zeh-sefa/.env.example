# Configuração da integração com a API da SEFA-PA (DEC).
# Copie para .env e preencha. O .env NÃO vai para o git.

# Endereço-base do realm (sem /protocol/...). Se você não souber, deixe vazio:
# o script deduz a partir do SEFA_TOKEN_URL.
SEFA_ISSUER_URL=

# Endpoint de token, exatamente como está no manual da SEFA.
SEFA_TOKEN_URL=

# Credenciais que você já obteve no Portal de Serviços.
SEFA_CLIENT_ID=
SEFA_CLIENT_SECRET=

# Escopo, se o manual pedir algum. Vazio = não envia o parâmetro.
SEFA_SCOPE=

# CNPJ da empresa, só dígitos.
SEFA_CNPJ=30889880000160

# Certificado A1 (e-CNPJ) em .pfx/.p12 e a senha dele.
# Em produção o Zeh lê isso do Secret Manager — este arquivo é só para
# rodar o diagnóstico na sua máquina.
SEFA_CERT_PFX=C:\caminho\para\certificado.pfx
SEFA_CERT_SENHA=

# Endpoint da API do DEC que lista as mensagens (para o teste final).
SEFA_API_URL=

# Só preencha se o manual mandar usar grant_type=password. Na dúvida, deixe
# vazio — o teste D é pulado.
SEFA_USUARIO_SENHA=
